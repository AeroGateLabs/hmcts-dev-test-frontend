{% extends "template.njk" %}

  {% block content %}
    <a class="govuk-back-link" href="/tasks">Back to tasks</a>
    <h1 class="govuk-heading-xl">{{ task.title }}</h1>

    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Description</dt>
        <dd class="govuk-summary-list__value">{{ task.description }}</dd>
      </div>

      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Status</dt>
        <dd class="govuk-summary-list__value">
          {% if task.status == 'PENDING' %}
            <strong class="govuk-tag govuk-tag--grey">
              {{ task.status }}
            </strong>
            {% elif task.status == 'ASSIGNED' %}
            <strong class="govuk-tag govuk-tag--light-blue">
              {{ task.status }}
            </strong>
            {% elif task.status == 'COMPLETED' %}
            <strong class="govuk-tag govuk-tag--green">
              {{ task.status }}
            </strong>
          {% endif %}
        </dd>
      </div>

      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Due date</dt>
        <dd class="govuk-summary-list__value">{{ task.dueDateTime }}</dd>
      </div>

      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Created date</dt>
        <dd class="govuk-summary-list__value">{{ task.createdDate }}</dd>
      </div>
    </dl>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        <div class="govuk-button-group">

          {% if task.status == 'PENDING' %}
            <form method="post" action="/tasks/{{ task.id }}/assign">
              <button class="govuk-button" type="submit">Assign</button>
            </form>
          {% endif %}

          {% if task.status == 'ASSIGNED' %}
            <form method="post" action="/tasks/{{ task.id }}/complete">
              <button class="govuk-button" type="submit">Complete</button>
            </form>

            <form method="post" action="/tasks/{{ task.id }}/unassign">
              <button class="govuk-button govuk-button--secondary" type="submit">Unassign</button>
            </form>
          {% endif %}

        </div>
      </div>

      <div class="govuk-grid-column-one-half govuk-!-text-align-right">
        <form class="task-actions__delete" method="post" action="/tasks/{{ task.id }}/delete">
          <button class="govuk-button govuk-button--warning" type="submit">Delete</button>
        </form>
      </div>


    </div>

  {% endblock %}
